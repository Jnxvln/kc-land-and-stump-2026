generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Photo {
  id          String   @id @default(cuid())
  width       Int
  height      Int
  alt         String   @default("")
  caption     String?
  visible     Boolean  @default(true)
  serviceSlug String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  placements  PhotoPlacement[]

  @@index([visible, createdAt])
  @@index([serviceSlug])
}

model PhotoPlacement {
  spot    String @id
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@index([photoId])
}

model SiteSettings {
  id          Int      @id @default(1)
  phone       String
  serviceArea String[]
  updatedAt   DateTime @updatedAt
}

/// Published wording that replaces an original from the code. No row = original.
model PageText {
  key       String   @id
  text      String
  updatedAt DateTime @updatedAt
}

/// Unpublished edits to one page, saved automatically while editing.
model PageDraft {
  page      String   @id
  content   Json
  updatedAt DateTime @updatedAt
}